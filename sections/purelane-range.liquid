{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
{{ 'purelane-range-wb.css' | asset_url | stylesheet_tag }}

{% style %}
  .pl-range-sec--{{ section.id }} {
    --pl-sec-y: {{ section.settings.padding_y }}px;
    background-color: {{ section.settings.bg_color }};
  }
{% endstyle %}

<section id="range" class="pl-range-sec pl-range-sec--{{ section.id }}" data-scene="3">
  <div class="pl-wrap">
    <div class="pl-range-panel pl-glass pl-rv">

      <div class="pl-range-head">
        <div>
          {% if section.settings.kicker != blank %}
            <p class="pl-kicker">{{ section.settings.kicker }}</p>
          {% endif %}
          <h2 class="pl-d2">{{ section.settings.heading }}</h2>
        </div>
        {% if section.settings.body != blank %}
          <p class="pl-range-head__body">{{ section.settings.body }}</p>
        {% endif %}
      </div>

      <div class="pl-stripwrap">
        <div class="pl-rangerow">
          <span class="pl-pimg pl-p-floor"    role="img" aria-label="Floor cleaner"></span>
          <span class="pl-pimg pl-p-tap"      role="img" aria-label="Tap cleaner"></span>
          <span class="pl-pimg pl-p-kitchen"  role="img" aria-label="Kitchen cleaner"></span>
          <span class="pl-pimg pl-p-toilet"   role="img" aria-label="Toilet cleaner"></span>
          <span class="pl-pimg pl-p-laundry"  role="img" aria-label="Laundry detergent"></span>
          <span class="pl-pimg pl-p-dish"     role="img" aria-label="Dishwash gel"></span>
          <span class="pl-pimg pl-p-metal"    role="img" aria-label="Metal cleaner"></span>
          <span class="pl-pimg pl-p-wm"       role="img" aria-label="Washing machine cleaner"></span>
          <span class="pl-pimg pl-p-handwash" role="img" aria-label="Liquid handwash"></span>
          <span class="pl-pimg pl-p-eraser"   role="img" aria-label="Magic eraser"></span>
        </div>
      </div>

      <p class="pl-striphint" aria-hidden="true">Swipe to see the full shelf</p>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(function (el) {
      observer.observe(el);
    });
  });
</script>

{% schema %}
{
  "name": "Purelane Full Range",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Copy",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    }
  ],
  "presets": [
    {
      "name": "Purelane Full Range"
    }
  ]
}
{% endschema %}
