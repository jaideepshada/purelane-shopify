{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

<section class="pl-sec" id="bundles" data-scene="3">
  <div class="pl-wrap">

    <div class="pl-glass pl-sec-pad pl-rv pl-bundles__head" style="margin-bottom: 14px;">
      <div class="pl-panel-head">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2" style="margin-top:12px; margin-bottom:16px;">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div class="pl-rule" style="margin-bottom:16px;">
          <i></i>{% render 'purelane-icons', name: 'leaf', size: 16 %}<i></i>
        </div>
        {%- if section.settings.subheading != blank -%}
          <p class="pl-lede" style="margin: 0 auto;">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="pl-tiers pl-rv" style="transition-delay:.15s;">
      {%- for block in section.blocks -%}
        {%- assign delay_class = '' -%}
        {%- if forloop.index == 2 -%}{%- assign delay_class = 'pl-rv-d2' -%}{%- endif -%}
        {%- if forloop.index == 3 -%}{%- assign delay_class = 'pl-rv-d3' -%}{%- endif -%}
        
        <div class="pl-glass pl-tier{% if block.settings.is_best %} pl-tier--best{% endif %} pl-rv {{ delay_class }}" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}
            <span class="pl-tier__tag">{{ block.settings.tag }}</span>
          {%- endif -%}

          {%- assign qty = block.settings.quantity | plus: 0 -%}
          {%- if qty == 0 -%}{%- assign qty = 3 -%}{%- endif -%}
          <div class="pl-tierpix{% if qty >= 5 %} pl-tierpix--five{% endif %}" aria-hidden="true">
            {%- if qty == 2 -%}
              <span class="pl-pimg pl-p-kitchen"></span>
              <span class="pl-pimg pl-p-tap"></span>
            {%- elsif qty == 3 -%}
              <span class="pl-pimg pl-p-kitchen"></span>
              <span class="pl-pimg pl-p-tap"></span>
              <span class="pl-pimg pl-p-dish"></span>
            {%- else -%}
              <span class="pl-pimg pl-p-kitchen"></span>
              <span class="pl-pimg pl-p-tap"></span>
              <span class="pl-pimg pl-p-floor"></span>
              <span class="pl-pimg pl-p-toilet"></span>
              <span class="pl-pimg pl-p-laundry"></span>
            {%- endif -%}
          </div>

          <div class="pl-tier__qty">
            {{ block.settings.quantity }}
            <small>Products</small>
          </div>

          <div class="pl-tier__price">
            ₹{{ block.settings.price }}
            {%- if block.settings.compare_price != blank -%}
              <s>₹{{ block.settings.compare_price }}</s>
            {%- endif -%}
          </div>
          
          {%- if block.settings.per_product != blank -%}
            <div class="pl-tier__per">₹{{ block.settings.per_product }} / product</div>
          {%- endif -%}

          <ul>
            {%- if block.settings.feature_1 != blank -%}
              <li>{% render 'purelane-icons', name: 'check' %} {{ block.settings.feature_1 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_2 != blank -%}
              <li>{% render 'purelane-icons', name: 'check' %} {{ block.settings.feature_2 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_3 != blank -%}
              <li>{% render 'purelane-icons', name: 'check' %} {{ block.settings.feature_3 }}</li>
            {%- endif -%}
          </ul>

          <a href="#" class="pl-btn pl-btn--{{ block.settings.button_style }}">
            Build this box
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;margin-left:6px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(el => {
      observer.observe(el);
    });
  });
</script>

