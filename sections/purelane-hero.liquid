{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_collection = section.settings.collection | default: 'shop'
  assign hero_product = collections[hero_collection].products.first
-%}

<section class="pl-hero" aria-label="Hero">
  <!-- Desktop Badges Rail -->
  <aside class="pl-hero__badges pl-glass pl-rv" style="transition-delay: 0.6s;">
    <div class="pl-hero__badge">
      <div class="pl-hero__badge-icon">
        {% render 'purelane-icons', name: 'leaf' %}
      </div>
      <span>{{ section.settings.badge_1_text }}</span>
    </div>
    <div class="pl-hero__badge">
      <div class="pl-hero__badge-icon">
        {% render 'purelane-icons', name: 'shield' %}
      </div>
      <span>{{ section.settings.badge_2_text }}</span>
    </div>
    <div class="pl-hero__badge">
      <div class="pl-hero__badge-icon">
        {% render 'purelane-icons', name: 'no-chemical' %}
      </div>
      <span>{{ section.settings.badge_3_text }}</span>
    </div>
  </aside>

  <div class="pl-hero__grid">
    <div class="pl-hero__copy">
      <div class="pl-hero__rule pl-rv">
        {% render 'purelane-icons', name: 'leaf' %}
        <i></i>
      </div>
      
      <h1 class="pl-d1 pl-rv" style="transition-delay: 0.1s;">
        {%- if section.settings.heading_highlight != blank -%}
          {{ section.settings.heading | replace: section.settings.heading_highlight, '<span class="pl-lime">' | append: section.settings.heading_highlight | append: '</span>' }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>
      
      <p class="pl-lede pl-rv" style="transition-delay: 0.2s;">
        {{ section.settings.subheading }}
      </p>

      <div class="pl-hero__cta pl-rv" style="transition-delay: 0.3s;">
        <a href="{{ section.settings.button_link }}" class="pl-btn pl-btn-primary">
          {{ section.settings.button_label }}
        </a>
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link }}" class="pl-btn pl-btn-ghost">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>

      <!-- Mobile Badge Strip -->
      <div class="pl-hero__strip pl-rv" style="transition-delay: 0.4s;">
        <div class="pl-hero__strip-item">
          {% render 'purelane-icons', name: 'leaf' %}
          {{ section.settings.badge_1_text }}
        </div>
        <div class="pl-hero__strip-item">
          {% render 'purelane-icons', name: 'shield' %}
          {{ section.settings.badge_2_text }}
        </div>
        <div class="pl-hero__strip-item">
          {% render 'purelane-icons', name: 'no-chemical' %}
          {{ section.settings.badge_3_text }}
        </div>
      </div>
    </div>
    
    {%- if hero_product -%}
      <div class="pl-hero__product pl-rv" style="transition-delay: 0.5s;">
        <img src="{{ hero_product.featured_image | image_url: width: 1000 }}" 
             alt="{{ hero_product.title | escape }}" 
             width="{{ hero_product.featured_image.width }}" 
             height="{{ hero_product.featured_image.height }}" 
             loading="eager" />
        
        <div class="pl-hero__ptag">
          <span class="pl-hero__ptag-label">Featured Product</span>
          <div class="pl-hero__ptag-val">
            <strong>₹{{ hero_product.price | divided_by: 100.0 | floor }}</strong>
            {%- if hero_product.compare_at_price > hero_product.price -%}
              <s>₹{{ hero_product.compare_at_price | divided_by: 100.0 | floor }}</s>
            {%- endif -%}
          </div>
          {%- if hero_product.compare_at_price > hero_product.price -%}
            {%- assign discount = hero_product.compare_at_price | minus: hero_product.price | times: 100.0 | divided_by: hero_product.compare_at_price | round -%}
            <span class="pl-hero__ptag-cut">Save {{ discount }}%</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(el => {
      observer.observe(el);
    });
  });
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean That Lasts"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlight Word",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Hero Collection (Product Showcase)"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Plant powered"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "Safe for kids & pets"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Zero harsh chemicals"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}
