{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_collection = section.settings.collection | default: 'shop'
  assign hero_product = collections[hero_collection].products.first
-%}

<section class="pl-hero" aria-label="Hero" data-scene="1">
  <div class="pl-hero__grid">
    <!-- Desktop Badges Rail -->
    <aside class="pl-hero__badges">
      <div class="pl-hero__badge">
        <div class="pl-hero__badge-icon">
          {% render 'purelane-icons', name: 'leaf' %}
        </div>
        <span>{{ section.settings.badge_1_text }}</span>
      </div>
      <div class="pl-hero__badge">
        <div class="pl-hero__badge-icon">
          {% render 'purelane-icons', name: 'shield' %}
        </div>
        <span>{% if section.settings.badge_2_text == 'Kids & pet safe' or section.settings.badge_2_text == 'KIDS & PET SAFE' %}SAFE FOR<br>KIDS &amp; PETS{% else %}{{ section.settings.badge_2_text }}{% endif %}</span>
      </div>
      <div class="pl-hero__badge">
        <div class="pl-hero__badge-icon">
          {% render 'purelane-icons', name: 'no-chemical' %}
        </div>
        <span>{{ section.settings.badge_3_text }}</span>
      </div>
    </aside>

    <div class="pl-hero__copy">
      <h1 class="pl-d1 pl-rv" style="transition-delay: 0.1s;">
        {%- if section.settings.heading_highlight != blank -%}
          {{ section.settings.heading | newline_to_br | replace: section.settings.heading_highlight, '<span class="pl-lime">' | append: section.settings.heading_highlight | append: '</span>' }}
        {%- else -%}
          {{ section.settings.heading | newline_to_br }}
        {%- endif -%}
      </h1>

      <div class="pl-hero__rule pl-rv" style="transition-delay: 0.15s;">
        <i></i>
        {% render 'purelane-icons', name: 'leaf' %}
        <i></i>
      </div>
      
      <div class="pl-lede pl-rv" style="transition-delay: 0.2s;">
        {{ section.settings.subheading }}
      </div>

      <div class="pl-hero__cta pl-rv" style="transition-delay: 0.3s;">
        <a href="{{ section.settings.button_link }}" class="pl-btn pl-btn-primary">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link }}" class="pl-btn pl-btn-ghost">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>

      <!-- Mobile Badge Strip -->
      <div class="pl-hero__strip pl-rv" style="transition-delay: 0.4s;">
        <div class="pl-hero__strip-item pl-glass-2">
          {% render 'purelane-icons', name: 'leaf' %}
          {{ section.settings.badge_1_text }}
        </div>
        <div class="pl-hero__strip-item pl-glass-2">
          {% render 'purelane-icons', name: 'shield' %}
          {{ section.settings.badge_2_text }}
        </div>
        <div class="pl-hero__strip-item pl-glass-2">
          {% render 'purelane-icons', name: 'no-chemical' %}
          {{ section.settings.badge_3_text | downcase | replace: 'chemicals', 'chem' | replace: 'chemical', 'chem' | upcase }}
        </div>
      </div>
    </div>

    <div class="pl-hero__product pl-rv" style="transition-delay: 0.5s;">
      <style>
        .p-kbtl { background-image: url('{{ "purelane-bottle-kbtl.svg" | asset_url }}'); aspect-ratio: 0.3541; }
        .p-tbtl { background-image: url('{{ "purelane-bottle-tbtl.svg" | asset_url }}'); aspect-ratio: 0.3541; }
        .p-mbtl { background-image: url('{{ "purelane-bottle-mbtl.svg" | asset_url }}'); aspect-ratio: 0.3541; }
      </style>
      <div class="hero-prod" id="heroProd">
        <div class="hstage" id="hstage">
          <div class="hslide hs1 on" data-n="1">
            <span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="pl-glass-2 ptag">
              <span class="lbl">Single bottle</span>
              <span class="val"><strong>&#8377;200</strong><s>&#8377;299</s></span>
              <span class="cut">33% off</span>
            </div>
          </div>
          <div class="hslide hs2" data-n="2">
            <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
            <span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="pl-glass-2 ptag">
              <span class="lbl">Any 2 products</span>
              <span class="val"><strong>&#8377;349</strong><s>&#8377;598</s></span>
              <span class="cut">Save &#8377;249</span>
            </div>
          </div>
          <div class="hslide hs3" data-n="3">
            <span class="hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
            <span class="hp p-mbtl b d2" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span>
            <span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="pl-glass-2 ptag">
              <span class="lbl">Any 3 products</span>
              <span class="val"><strong>&#8377;499</strong><s>&#8377;897</s></span>
              <span class="cut">Save &#8377;398</span>
            </div>
          </div>
        </div>
        <div class="hdots" id="hdots">
          <button type="button" class="on" aria-label="Show 1 product"></button>
          <button type="button" class="" aria-label="Show 2 products"></button>
          <button type="button" class="" aria-label="Show 3 products"></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revs = document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv');
    
    if ('IntersectionObserver' in window && !reduce) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });

      revs.forEach(el => observer.observe(el));
    } else {
      revs.forEach(el => el.classList.add('in'));
    }

    const hstage = document.getElementById('hstage');
    if (hstage) {
      const hs = Array.from(hstage.querySelectorAll('.hslide'));
      const hd = Array.from(document.querySelectorAll('#hdots button'));
      let hi = 0, htimer = null;
      function hgo(n) {
        hi = (n + hs.length) % hs.length;
        hs.forEach((s, i) => s.classList.toggle('on', i === hi));
        hd.forEach((d, i) => d.classList.toggle('on', i === hi));
      }
      function hplay() { if (!htimer) htimer = setInterval(() => hgo(hi + 1), 3800); }
      function hstop() { if (htimer) { clearInterval(htimer); htimer = null; } }
      hd.forEach((d, i) => {
        d.addEventListener('click', () => { hstop(); hgo(i); hplay(); });
      });
      hstage.addEventListener('mouseenter', hstop);
      hstage.addEventListener('mouseleave', hplay);
      const hio = new IntersectionObserver((es) => {
        es.forEach(e => { e.isIntersecting ? hplay() : hstop(); });
      }, { threshold: 0.2 });
      hio.observe(hstage);
    }

    const prod = document.getElementById('heroProd');
    if (prod && typeof prod.animate === 'function') {
      prod.animate(
        [{ filter: 'drop-shadow(0 18px 36px rgba(0,74,66,.16))' },
         { filter: 'drop-shadow(0 24px 44px rgba(0,74,66,.24))' },
         { filter: 'drop-shadow(0 18px 36px rgba(0,74,66,.16))' }],
        { duration: 7000, iterations: Infinity, easing: 'ease-in-out' }
      );
    }
  })();
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Clean\nThat\nLasts"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlight Word",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Hero Collection (Product Showcase)"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Plant powered"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "Kids & pet safe"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Zero harsh chemicals"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}
