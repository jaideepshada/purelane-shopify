{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_collection = section.settings.collection | default: 'shop'
  assign hero_product = collections[hero_collection].products.first
-%}

<section class="pl-hero" aria-label="Hero" data-scene="1">
  <!-- Desktop Badges Rail -->
  <aside class="pl-hero__badges pl-glass pl-rv" style="transition-delay: 0.6s;">
    <div class="pl-hero__badge">
      <div class="pl-hero__badge-icon">
        {% render 'purelane-icons', name: 'leaf' %}
      </div>
      <span>{{ section.settings.badge_1_text }}</span>
    </div>
    <div class="pl-hero__badge">
      <div class="pl-hero__badge-icon">
        {% render 'purelane-icons', name: 'shield' %}
      </div>
      <span>{{ section.settings.badge_2_text }}</span>
    </div>
    <div class="pl-hero__badge">
      <div class="pl-hero__badge-icon">
        {% render 'purelane-icons', name: 'no-chemical' %}
      </div>
      <span>{{ section.settings.badge_3_text }}</span>
    </div>
  </aside>

  <div class="pl-hero__grid">
    <div class="pl-hero__copy">
      <h1 class="pl-d1 pl-rv" style="transition-delay: 0.1s;">
        {%- if section.settings.heading_highlight != blank -%}
          {{ section.settings.heading | newline_to_br | replace: section.settings.heading_highlight, '<span class="pl-lime">' | append: section.settings.heading_highlight | append: '</span>' }}
        {%- else -%}
          {{ section.settings.heading | newline_to_br }}
        {%- endif -%}
      </h1>

      <div class="pl-hero__rule pl-rv" style="transition-delay: 0.15s;">
        <i></i>
        {% render 'purelane-icons', name: 'leaf' %}
        <i></i>
      </div>
      
      <p class="pl-lede pl-rv" style="transition-delay: 0.2s;">
        {{ section.settings.subheading }}
      </p>

      <div class="pl-hero__cta pl-rv" style="transition-delay: 0.3s;">
        <a href="{{ section.settings.button_link }}" class="pl-btn pl-btn-primary">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link }}" class="pl-btn pl-btn-ghost">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>

      <!-- Mobile Badge Strip -->
      <div class="pl-hero__strip pl-rv" style="transition-delay: 0.4s;">
        <div class="pl-hero__strip-item">
          {% render 'purelane-icons', name: 'leaf' %}
          {{ section.settings.badge_1_text }}
        </div>
        <div class="pl-hero__strip-item">
          {% render 'purelane-icons', name: 'shield' %}
          {{ section.settings.badge_2_text }}
        </div>
        <div class="pl-hero__strip-item">
          {% render 'purelane-icons', name: 'no-chemical' %}
          {{ section.settings.badge_3_text }}
        </div>
      </div>
    </div>

    <div class="pl-hero__product pl-rv" style="transition-delay: 0.5s;">
      <div class="rot" id="rot" aria-hidden="true">
        <div class="frame">
          <img src="{{ 'purelane-bottle-kbtl.svg' | asset_url }}" class="pl-hero__bottle on" data-name="Kitchen cleaner" data-note="Foam lifts grease, no scrubbing" alt="" />
          <img src="{{ 'purelane-bottle-tbtl.svg' | asset_url }}" class="pl-hero__bottle" data-name="Tap &amp; limescale" data-note="Melts hard water stains" alt="" />
          <img src="{{ 'purelane-bottle-mbtl.svg' | asset_url }}" class="pl-hero__bottle" data-name="Laundry detergent" data-note="Tough on odour, soft on fabric" alt="" />
          <img src="{{ 'purelane-bottle-kitchen.svg' | asset_url }}" class="pl-hero__bottle" data-name="Dishwash gel" data-note="Cuts grease, kind to hands" alt="" />
          <img src="{{ 'purelane-bottle-tap.svg' | asset_url }}" class="pl-hero__bottle" data-name="Toilet cleaner" data-note="Kills 99.9% of germs" alt="" />
        </div>
        <div class="cap">
          <b>Kitchen cleaner</b>
          <span>Foam lifts grease, no scrubbing</span>
        </div>
        <div class="dots">
          <i class="on"></i><i></i><i></i><i></i><i></i>
        </div>
      </div>
      
      <div class="pl-hero__ptag">
        {%- if hero_product -%}
          <span class="pl-hero__ptag-label">Best-seller combo</span>
          <div class="pl-hero__ptag-val">
            <strong>₹{{ hero_product.price | money_without_currency | strip | replace: '.00', '' }}</strong>
            {%- if hero_product.compare_at_price > hero_product.price -%}
              <s>₹{{ hero_product.compare_at_price | money_without_currency | strip | replace: '.00', '' }}</s>
            {%- endif -%}
          </div>
          {%- if hero_product.compare_at_price > hero_product.price -%}
            {%- assign discount_amount = hero_product.compare_at_price | minus: hero_product.price | money_without_currency | strip | replace: '.00', '' -%}
            <span class="pl-hero__ptag-cut">SAVE ₹{{ discount_amount }}</span>
          {%- endif -%}
        {%- else -%}
          <span class="pl-hero__ptag-label">Any 3 products</span>
          <div class="pl-hero__ptag-val">
            <strong>₹499</strong>
            <s>₹897</s>
          </div>
          <span class="pl-hero__ptag-cut">Save ₹398</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(el => {
      observer.observe(el);
    });

    const rot = document.getElementById('rot');
    if (rot) {
      const rimgs = Array.from(rot.querySelectorAll('.frame .pl-hero__bottle'));
      const rdots = Array.from(rot.querySelectorAll('.dots i'));
      const rcapB = rot.querySelector('.cap b');
      const rcapS = rot.querySelector('.cap span');
      let ri = 0, rtimer = null;
      
      function rstep() {
        rimgs[ri].classList.remove('on');
        if (rdots[ri]) rdots[ri].classList.remove('on');
        ri = (ri + 1) % rimgs.length;
        rimgs[ri].classList.add('on');
        if (rdots[ri]) rdots[ri].classList.add('on');
        rcapB.innerHTML = rimgs[ri].getAttribute('data-name');
        rcapS.textContent = rimgs[ri].getAttribute('data-note');
      }
      
      const rio = new IntersectionObserver((es) => {
        es.forEach(e => {
          if (e.isIntersecting && !rtimer) rtimer = setInterval(rstep, 2900);
          else if (!e.isIntersecting && rtimer) { clearInterval(rtimer); rtimer = null; }
        });
      }, { threshold: 0.25 });
      rio.observe(rot);
    }
  });
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Clean\nThat\nLasts"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlight Word",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Hero Collection (Product Showcase)"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Plant powered"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "Safe for kids & pets"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Zero harsh chemicals"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}
