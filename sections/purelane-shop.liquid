{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}

<section id="shop" class="pl-sec" aria-label="{{ section.settings.heading }}" data-scene="3">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      <span class="pl-kicker">{{ section.settings.kicker }}</span>
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        {% render 'purelane-icons', name: 'leaf', size: 16 %}
        <i></i>
      </div>
    </div>
    <div class="pl-shelf">
      {% for product in section.settings.collection.products limit: section.settings.products_per_page %}
        {% assign delay_index = forloop.index0 | modulo: 4 %}
        {% render 'purelane-product-card', product: product, delay_class: delay_index %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
// IntersectionObserver reveal animation
(function(){
  if(window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
  var els = document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv');
  if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return;}
  var o = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){e.target.classList.add('in');o.unobserve(e.target);}
    });
  },{rootMargin:'0px 0px -12% 0px',threshold:0.12});
  els.forEach(function(el){o.observe(el);});
})();

// Add to cart — fetch handler
(function () {
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form.classList.contains('pl-atc-form')) return;
    e.preventDefault();
    var btn   = form.querySelector('.pl-card__atc');
    var label = form.querySelector('.pl-atc__label');
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    label.textContent = 'Adding…';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: Number(form.querySelector('[name="id"]').value), quantity: 1 })
    })
    .then(function (r) {
      if (!r.ok) throw new Error('cart_error');
      return r.json();
    })
    .then(function () {
      label.textContent = 'Added ✓';
      btn.style.cssText = 'background:rgba(79,125,16,.15);border-color:#4f7d10;color:#4f7d10';
      return fetch('/cart.js');
    })
    .then(function (r) { return r.json(); })
    .then(function (cart) {
      document.querySelectorAll('.pl-dot').forEach(function (d) {
        d.textContent = cart.item_count;
        d.style.display = cart.item_count > 0 ? 'grid' : 'none';
      });
    })
    .catch(function () {
      label.textContent = 'Error — retry';
      btn.style.cssText = 'border-color:#c0392b;color:#c0392b';
    })
    .finally(function () {
      setTimeout(function () {
        btn.disabled = false;
        btn.style.cssText = '';
        label.textContent = 'Add to cart';
      }, 2200);
    });
  });
})();
</script>

{% schema %}
{
  "name": "Purelane — Shop Grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane — Shop Grid",
      "settings": {
        "kicker": "Bestsellers",
        "heading": "Loved by 30,000 homes"
      }
    }
  ]
}
{% endschema %}
