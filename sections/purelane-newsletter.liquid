{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-cats-trust-signup.css' | asset_url | stylesheet_tag }}

{% style %}
  .pl-signup-sec--{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
{% endstyle %}

<section class="pl-signup-sec pl-signup-sec--{{ section.id }}" data-scene="4">
  <div class="pl-wrap">
    <div class="pl-signup-panel pl-glass pl-rv">

      {% if section.settings.kicker != blank %}
        <p class="pl-kicker">{{ section.settings.kicker }}</p>
      {% endif %}

      <h2 class="pl-d2">{{ section.settings.heading }}</h2>

      {% if section.settings.subtext != blank %}
        <p class="pl-signup-lede">{{ section.settings.subtext }}</p>
      {% endif %}

      <form
        class="pl-signup-form"
        id="pl-signup-form-{{ section.id }}"
        action="/contact#contact_form"
        method="post"
        accept-charset="UTF-8"
        novalidate
      >
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          class="pl-signup-input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder }}"
          aria-label="Email address"
          required
          autocomplete="email"
        >
        <button class="pl-signup-btn" type="submit">
          {{ section.settings.button_label }}
        </button>
      </form>

      <p class="pl-signup-success" id="pl-signup-success-{{ section.id }}" style="display:none;color:#4f7d10;font-weight:600;margin-top:12px;">
        🎉 You're in! Check your inbox for your ₹100 off code.
      </p>
      <p class="pl-signup-error" id="pl-signup-error-{{ section.id }}" style="display:none;color:#c0392b;font-weight:600;margin-top:12px;">
        Please enter a valid email address.
      </p>

    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('pl-signup-form-{{ section.id }}');
    var success = document.getElementById('pl-signup-success-{{ section.id }}');
    var error = document.getElementById('pl-signup-error-{{ section.id }}');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value.trim();
      var re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!re.test(email)) {
        error.style.display = 'block';
        success.style.display = 'none';
        return;
      }
      error.style.display = 'none';

      var data = new FormData(form);
      fetch('/contact#contact_form', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: data
      }).then(function () {
        form.style.display = 'none';
        success.style.display = 'block';
      }).catch(function () {
        /* fallback — native submit */
        form.submit();
      });
    });

    /* reveal animation */
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(function (el) { obs.observe(el); });
  })();
</script>


{% schema %}
{
  "name": "Purelane Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get my ₹100 off"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    }
  ],
  "presets": [
    {
      "name": "Purelane Newsletter"
    }
  ]
}
{% endschema %}
