        {
          "type": "rotator_item",
          "settings": {
            "product_key": "toilet",
            "caption_title": "Toilet cleaner",
            "caption_note": "Kills 99.9% of germs"
          }
        },
        {
          "type": "rotator_item",
          "settings": {
            "product_key": "floor",
            "caption_title": "Floor cleaner",
            "caption_note": "Neem powered, pet safe"
          }
