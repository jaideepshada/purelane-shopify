{{ 'purelane-footer.css' | asset_url | stylesheet_tag }}

<footer class="pl-footer" data-scene="4">
  <div class="pl-wrap">
    <div class="pl-footer-grid">
      <div class="pl-footer-col">
        <a class="pl-footer-brand" href="#top">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg>
          </span>
          <span class="txt">
            <span class="n1">{{ shop.name | default: 'Purelane' }}</span>
            <span class="n2">{{ section.settings.tagline | default: 'Clean, simply' }}</span>
          </span>
        </a>
        <p style="max-width:30ch">{{ section.settings.about_text }}</p>
      </div>

      {%- for block in section.blocks -%}
        <div class="pl-footer-col" {{ block.shopify_attributes }}>
          {%- if block.type == 'link_list' -%}
            {%- if block.settings.heading != blank -%}
              <h5>{{ block.settings.heading }}</h5>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback links if no menu selected -->
              <a href="#">Link 1</a>
              <a href="#">Link 2</a>
              <a href="#">Link 3</a>
            {%- endif -%}
          {%- elsif block.type == 'contact' -%}
            {%- if block.settings.heading != blank -%}
              <h5>{{ block.settings.heading }}</h5>
            {%- endif -%}
            {%- if block.settings.email != blank -%}
              <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <a href="tel:{{ block.settings.phone | replace: ' ', '' }}">{{ block.settings.phone }}</a>
            {%- endif -%}
            {%- if block.settings.company != blank -%}
              <p style="font-size:12px;color:rgba(36,26,61,.56)">{{ block.settings.company }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="pl-footer-bot">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text }}</span>
      <span>
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}" style="display:inline; color:inherit; text-decoration:none; margin:0;">
            {{ link.title }}
          </a>{% unless forloop.last %} &middot; {% endunless %}
        {%- else -%}
          Privacy &middot; Terms &middot; Refunds &middot; Contact
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Purelane Eco Products Private Limited"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal Menu"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact Info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Get in touch"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "hello@purelane.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+91 9930 123 234"
        },
        {
          "type": "text",
          "id": "company",
          "label": "Company Name",
          "default": "Purelane Eco Products Pvt Ltd"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "About"
          }
        },
        {
          "type": "contact"
        }
      ]
    }
  ]
}
{% endschema %}
