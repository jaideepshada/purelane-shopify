{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
{{ 'purelane-cats-trust-signup.css' | asset_url | stylesheet_tag }}

{% style %}
  .pl-cats-sec--{{ section.id }} {
    --pl-sec-y: {{ section.settings.padding_y }}px;
    background-color: {{ section.settings.bg_color }};
  }
{% endstyle %}

<section id="categories" class="pl-cats-sec pl-cats-sec--{{ section.id }}" data-scene="4">
  <div class="pl-wrap">

    <div class="pl-cats-head pl-panel-head pl-rv">
      {% if section.settings.kicker != blank %}
        <p class="pl-kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      <h2 class="pl-d2">{{ section.settings.heading }}</h2>
    </div>

    <div class="pl-cats-grid">
      {% for block in section.blocks %}
        <a class="pl-cat pl-glass pl-rv pl-rv-d{{ forloop.index }}"
           href="{{ block.settings.link | default: '#shopify-section-purelane_combos' }}"
           {{ block.shopify_attributes }}>

          <span class="pl-cat__ph">
            <span class="pl-pimg pl-p-{{ block.settings.product_key }}"
                  role="img"
                  aria-label="{{ block.settings.heading }}"></span>
          </span>

          <span class="pl-cat__txt">
            <h4>{{ block.settings.heading }}</h4>
            {% if block.settings.subtext != blank %}
              <p>{{ block.settings.subtext }}</p>
            {% endif %}
          </span>

        </a>
      {% endfor %}
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(function (el) { obs.observe(el); });
  });
</script>

{% schema %}
{
  "name": "Purelane Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "select",
          "id": "product_key",
          "label": "Product Image",
          "options": [
            { "value": "kitchen",  "label": "Kitchen Cleaner" },
            { "value": "toilet",   "label": "Toilet Cleaner" },
            { "value": "laundry",  "label": "Laundry Detergent" },
            { "value": "tap",      "label": "Tap Cleaner" },
            { "value": "floor",    "label": "Floor Cleaner" },
            { "value": "dish",     "label": "Dishwash Gel" },
            { "value": "handwash", "label": "Liquid Handwash" }
          ],
          "default": "kitchen"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Bundle Name",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Grease, dishes & more"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link (use #section-id for anchors)",
          "default": "#shopify-section-purelane_combos"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        { "type": "category", "settings": { "product_key": "kitchen", "heading": "Kitchen bundle",    "subtext": "Grease, dishes & more",   "link": "#shopify-section-purelane_combos" } },
        { "type": "category", "settings": { "product_key": "toilet",  "heading": "Bathroom bundle",   "subtext": "Deep clean & disinfect",   "link": "#shopify-section-purelane_combos" } },
        { "type": "category", "settings": { "product_key": "laundry", "heading": "Laundry bundle",    "subtext": "Softer, fresher wash",      "link": "#shopify-section-purelane_combos" } },
        { "type": "category", "settings": { "product_key": "tap",     "heading": "Hard water bundle", "subtext": "Melt away limescale",       "link": "#shopify-section-purelane_combos" } }
      ]
    }
  ]
}
{% endschema %}
