{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}

<section id="combos" class="pl-sec" data-scene="3">
  <div class="pl-wrap">
    
    <div class="pl-panel-head">
      {% if section.settings.kicker != blank %}
        <span class="pl-kicker pl-rv">{{ section.settings.kicker }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="pl-d2 pl-rv" style="transition-delay: .1s;">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="pl-rule pl-rv" style="transition-delay: .15s;">
        <i></i>{% render 'purelane-icons', name: 'leaf' %}<i></i>
      </div>
      {% if section.settings.lede != blank %}
        <p class="pl-lede pl-rv" style="margin: 14px auto 0; transition-delay: .2s;">{{ section.settings.lede }}</p>
      {% endif %}
    </div>

    <div class="pl-combo-slider" id="combo-slider-{{ section.id }}">
    <div class="pl-comborail pl-rv" id="comborail-{{ section.id }}" style="transition-delay: .3s;">
      {% for block in section.blocks %}
        <div class="pl-glass pl-combo {% if block.settings.is_hero %}pl-combo--hero{% endif %}" {{ block.shopify_attributes }}>
          <div class="pl-combo__tray">
            {% if block.settings.save_label != blank %}
              <div class="pl-combo__save">{{ block.settings.save_label }}</div>
            {% endif %}
            {% if block.settings.flag_text != blank %}
              <div class="pl-combo__flag">{{ block.settings.flag_text }}</div>
            {% endif %}
            
            
            <div class="pl-stack">
              {% if block.settings.product_1_title != blank %}
                {% assign icon1 = block.settings.product_1_icon %}
                {% if icon1 == blank %}
                  {% assign t = block.settings.product_1_title | downcase %}
                  {% if t contains 'grease' %}{% assign icon1 = 'kitchen' %}
                  {% elsif t contains 'odour' or t contains 'laundry' %}{% assign icon1 = 'laundry' %}
                  {% elsif t contains 'germ' and block.settings.name == 'Complete home bundle' %}{% assign icon1 = 'floor' %}
                  {% elsif t contains 'germ' or t contains 'limescale' %}{% assign icon1 = 'toilet' %}
                  {% elsif t contains 'scum' %}{% assign icon1 = 'eraser' %}
                  {% elsif t contains 'hand' %}{% assign icon1 = 'handwash' %}
                  {% else %}{% assign icon1 = 'tap' %}{% endif %}
                {% endif %}
                <div class="pl-stack__item">
                  <div class="pl-pimg pl-p-{{ icon1 }}"></div>
                  <span>{{ block.settings.product_1_title }}</span>
                </div>
              {% endif %}
              
              {% if block.settings.product_2_title != blank or block.settings.product_2_is_placeholder %}
                <div class="pl-stack__plus">+</div>
                <div class="pl-stack__item">
                  {% if block.settings.product_2_is_placeholder %}
                    <div class="pl-stack__tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:32px;height:32px;margin:16px auto;"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></div>
                  {% else %}
                    {% assign icon2 = block.settings.product_2_icon %}
                    {% if icon2 == blank %}
                      {% assign t = block.settings.product_2_title | downcase %}
                      {% if t contains 'dish' %}{% assign icon2 = 'dish' %}
                      {% elsif t contains 'floor' or t contains 'germ' %}{% assign icon2 = 'floor' %}
                      {% elsif t contains 'limescale' %}{% assign icon2 = 'toilet' %}
                      {% elsif t contains 'tap' or t contains 'water' %}{% assign icon2 = 'tap' %}
                      {% else %}{% assign icon2 = 'tap' %}{% endif %}
                    {% endif %}
                    <div class="pl-pimg pl-p-{{ icon2 }}"></div>
                  {% endif %}
                  {% if block.settings.product_2_title != blank %}
                    <span>{{ block.settings.product_2_title }}</span>
                  {% endif %}
                </div>
              {% endif %}
              
              {% if block.settings.product_3_title != blank %}
                <div class="pl-stack__plus">+</div>
                <div class="pl-stack__item">
                  {% assign icon3 = block.settings.product_3_icon %}
                  {% if icon3 == blank %}
                    {% assign t = block.settings.product_3_title | downcase %}
                    {% if t contains 'stain' or t contains 'tap' %}{% assign icon3 = 'tap' %}
                    {% elsif t contains 'machine' %}{% assign icon3 = 'wm' %}
                    {% elsif t contains 'hand' %}{% assign icon3 = 'handwash' %}
                    {% elsif t contains 'scum' %}{% assign icon3 = 'eraser' %}
                    {% else %}{% assign icon3 = 'tap' %}{% endif %}
                  {% endif %}
                  <div class="pl-pimg pl-p-{{ icon3 }}"></div>
                  <span>{{ block.settings.product_3_title }}</span>
                </div>
              {% endif %}
            </div>
          </div>
          
          <div class="pl-combo__body">
            <h3>{{ block.settings.name }}</h3>
            {% if block.settings.count != blank %}
              <span class="pl-combo__count">{{ block.settings.count }}</span>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="pl-combo__desc">{{ block.settings.description }}</p>
            {% endif %}
            
            <div class="pl-combo__prow">
              {% if block.settings.product != blank %}
                <strong>₹{{ block.settings.product.price | divided_by: 100 }}</strong>
                {% if block.settings.product.compare_at_price > block.settings.product.price %}
                  <s>₹{{ block.settings.product.compare_at_price | divided_by: 100 }}</s>
                {% endif %}
                {% assign save_val = block.settings.product.compare_at_price | minus: block.settings.product.price %}
                {% if save_val > 0 %}
                  <em>Save ₹{{ save_val | divided_by: 100 }}</em>
                {% endif %}
              {% else %}
                <strong>₹{{ block.settings.price }}</strong>
                {% if block.settings.compare_price != blank %}
                  <s>₹{{ block.settings.compare_price }}</s>
                {% endif %}
                {% if block.settings.save_amount != blank %}
                  <em>Save ₹{{ block.settings.save_amount }}</em>
                {% endif %}
              {% endif %}
            </div>
            <span class="pl-combo__fine">Inclusive of all taxes &middot; COD available</span>
            
            <a href="{% if block.settings.product != blank %}{{ block.settings.product.url }}{% else %}#bundles{% endif %}" class="pl-btn {% if block.settings.is_hero %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}">
              Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
    </div><!-- /pl-combo-slider -->

    <div class="pl-swipecue pl-rv" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos
    </div>

    <div class="pl-slider-controls pl-rv" style="transition-delay: .4s;">
      <button class="pl-slider-btn pl-slider-btn--prev" id="combo-prev-{{ section.id }}" aria-label="Previous combo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="pl-slider-dots" id="combo-dots-{{ section.id }}">
        {% for block in section.blocks %}
          <button class="pl-slider-dot{% if forloop.first %} on{% endif %}" aria-label="Go to combo {{ forloop.index }}"></button>
        {% endfor %}
      </div>
      <button class="pl-slider-btn pl-slider-btn--next" id="combo-next-{{ section.id }}" aria-label="Next combo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <p class="pl-railnote pl-rv" style="transition-delay: .5s;">
      Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.
    </p>
    
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* — reveal animation — */
    const revealObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          revealObs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(el => revealObs.observe(el));

    /* — slider controller — */
    const rail  = document.getElementById('comborail-{{ section.id }}');
    const dots  = Array.from(document.querySelectorAll('#combo-dots-{{ section.id }} .pl-slider-dot'));
    const prev  = document.getElementById('combo-prev-{{ section.id }}');
    const next  = document.getElementById('combo-next-{{ section.id }}');
    const cards = Array.from(rail.querySelectorAll('.pl-combo'));

    if (!rail || !cards.length) return;

    let current = 0;

    function scrollTo(idx) {
      idx = Math.max(0, Math.min(idx, cards.length - 1));
      cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      setActive(idx);
    }

    function setActive(idx) {
      current = idx;
      dots.forEach((d, i) => d.classList.toggle('on', i === idx));
      if (prev) prev.style.opacity = idx === 0 ? '0.35' : '1';
      if (next) next.style.opacity = idx === cards.length - 1 ? '0.35' : '1';
    }

    /* sync dots while user scrolls natively */
    const snapObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const idx = cards.indexOf(entry.target);
          if (idx !== -1) setActive(idx);
        }
      });
    }, { root: rail, threshold: 0.55 });
    cards.forEach(c => snapObs.observe(c));

    dots.forEach((d, i) => d.addEventListener('click', () => scrollTo(i)));
    if (prev) prev.addEventListener('click', () => scrollTo(current - 1));
    if (next) next.addEventListener('click', () => scrollTo(current + 1));

    setActive(0);
  });
</script>

