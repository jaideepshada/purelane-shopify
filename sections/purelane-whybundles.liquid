{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-range-wb.css' | asset_url | stylesheet_tag }}

{% style %}
  .pl-whybundles-sec--{{ section.id }} {
    --pl-sec-y: {{ section.settings.padding_y }}px;
    background-color: {{ section.settings.bg_color }};
  }
{% endstyle %}

<section id="whybundles" class="pl-whybundles-sec pl-whybundles-sec--{{ section.id }}" data-scene="4">
  <div class="pl-wrap">
    <div class="pl-sec-pad pl-glass pl-rv">

      <div class="pl-panel-head">
        {% if section.settings.kicker != blank %}
          <p class="pl-kicker">{{ section.settings.kicker }}</p>
        {% endif %}
        <h2 class="pl-d2">{{ section.settings.heading }}</h2>
      </div>

      <div class="pl-wb-grid">
        {% for block in section.blocks %}
          <div class="pl-wb-item{% if forloop.index > 1 %} pl-rv pl-rv-d{{ forloop.index }}{% endif %}" {{ block.shopify_attributes }}>

            <div class="pl-wb-icon" aria-hidden="true">
              {% case block.settings.icon %}

                {% when 'savings' %}
                  {%- comment -%} Dollar sign — Save up to 45% {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18"/>
                    <path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/>
                  </svg>

                {% when 'price' %}
                  {%- comment -%} Rounded square checkbox — One flat price {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="3.4"/>
                    <path d="m8.4 12.2 2.4 2.4 4.8-5"/>
                  </svg>

                {% when 'expert' %}
                  {%- comment -%} Star — Curated by experts {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/>
                  </svg>

                {% when 'shipping' %}
                  {%- comment -%} Delivery truck — Free shipping always {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2.6 16.4V7.2h10.2v9.2"/>
                    <path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/>
                    <circle cx="6.6" cy="18" r="1.9"/>
                    <circle cx="16.6" cy="18" r="1.9"/>
                  </svg>

                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                    <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                  </svg>
              {% endcase %}
            </div>

            <h3 class="pl-wb-title">{{ block.settings.title }}</h3>
            {% if block.settings.description != blank %}
              <p class="pl-wb-desc">{{ block.settings.description }}</p>
            {% endif %}

          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(function (el) {
      observer.observe(el);
    });
  });
</script>

{% schema %}
{
  "name": "Purelane Why Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "savings",  "label": "Dollar / Savings" },
            { "value": "price",    "label": "Checkbox / Flat Price" },
            { "value": "expert",   "label": "Star / Curated" },
            { "value": "shipping", "label": "Truck / Free Shipping" }
          ],
          "default": "savings"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Save up to 45%"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Versus buying the same products separately"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Purelane Why Bundles",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "savings",
            "title": "Save up to 45%",
            "description": "Versus buying the same products separately"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "price",
            "title": "One flat price",
            "description": "No calculators, no comparing carts"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "expert",
            "title": "Curated by experts",
            "description": "Products picked to work well together"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shipping",
            "title": "Free shipping always",
            "description": "Included on every bundle, all India"
          }
        }
      ]
    }
  ]
}
{% endschema %}
