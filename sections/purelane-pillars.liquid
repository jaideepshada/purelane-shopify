{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-pillars.css' | asset_url | stylesheet_tag }}

{% style %}
  .pl-pillars-sec--{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }
  {% endstyle %}

<section id="how" class="pl-pillars-sec pl-pillars-sec--{{ section.id }}" data-scene="2">
  <div class="pl-wrap">
    <div class="pl-pillars-grid">

      {% for block in section.blocks %}
        <article class="pl-pillar pl-glass pl-rv{% if forloop.index > 1 %} pl-rv-d{{ forloop.index }}{% endif %}" {{ block.shopify_attributes }}>

          {%- comment -%} Icon badge {%- endcomment -%}
          <span class="pl-pillar__icon" aria-hidden="true">
            {% case block.settings.icon %}

              {% when 'foam' %}
                {%- comment -%} Bubbles / foam icon — Less Scrubbing {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="8" cy="8.5" r="3.2"/>
                  <circle cx="16.4" cy="6.6" r="2.2"/>
                  <circle cx="15" cy="13" r="2.8"/>
                  <circle cx="8.6" cy="15.6" r="2.1"/>
                  <path d="M4 21h16"/>
                </svg>

              {% when 'shield' %}
                {%- comment -%} Shield with checkmark — Clean Ingredients {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
                  <path d="m9 12 2.2 2.2L15.4 10"/>
                </svg>

              {% when 'heart' %}
                {%- comment -%} Heart / safe icon — Safe Around Everyone {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/>
                </svg>

              {% else %}
                {%- comment -%} Fallback: leaf {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                  <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                </svg>

            {% endcase %}
          </span>

          <h3 class="pl-pillar__title">{{ block.settings.heading }}</h3>

          {% if block.settings.body != blank %}
            <p class="pl-pillar__body">{{ block.settings.body }}</p>
          {% endif %}

          {% if block.settings.link != blank %}
            <a class="pl-pillar__btn" href="{{ block.settings.link }}">Learn more</a>
          {% endif %}

        </article>
      {% endfor %}

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });

    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(el => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "Purelane Pillars",
  "settings": [
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "foam",   "label": "Foam / Bubbles (Less Scrubbing)" },
            { "value": "shield", "label": "Shield / Checkmark (Clean Ingredients)" },
            { "value": "heart",  "label": "Heart / Safe (Safe Around Everyone)" }
          ],
          "default": "foam"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body Copy",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "link",
          "label": "Learn More Link (use #section-id for anchors)",
          "default": "#"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Purelane Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "foam",
            "heading": "Less scrubbing",
            "body": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "link": "#shopify-section-purelane_shop"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "shield",
            "heading": "Clean ingredients",
            "body": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "link": "#shopify-section-purelane_ingredients"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "heart",
            "heading": "Safe around everyone",
            "body": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "link": "#shopify-section-purelane_shop"
          }
        }
      ]
    }
  ]
}
{% endschema %}
