{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-reviews.css' | asset_url | stylesheet_tag }}

{% style %}
  .pl-revband--{{ section.id }} {
    --pl-sec-y: {{ section.settings.padding_y }}px;
    background-color: {{ section.settings.bg_color }};
  }
  @media (max-width: 768px) {
    .pl-revband--{{ section.id }} {
      --pl-sec-y: {{ section.settings.padding_y | divided_by: 1.5 }}px;
    }
  }
{% endstyle %}

<section id="reviews" class="pl-revband pl-revband--{{ section.id }} pl-rv" aria-label="Customer Reviews" data-scene="1">
  <div class="pl-wrap">
    <div class="pl-revhead">
      {% if section.settings.kicker != blank %}
        <h2 class="pl-kicker">{{ section.settings.kicker }}</h2>
      {% endif %}
      <span class="pl-revhead__agg">
        <span class="pl-revhead__stars" aria-hidden="true">★★★★★</span><span class="visually-hidden">{{ section.settings.aggregate_rating }} out of 5 stars</span>
        <b>{{ section.settings.aggregate_rating }}</b>
        from {{ section.settings.total_reviews }} reviews
      </span>
      <span class="pl-revhead__agg">
        Loved by <b>{{ section.settings.homes_count }}</b> homes
      </span>
    </div>
  </div>

  <div class="pl-revrail">
    <div class="pl-revtrack" aria-live="off" role="marquee">
      {% comment %} Render blocks twice for seamless infinite scroll {% endcomment %}
      {% for i in (1..2) %}
        {% for block in section.blocks %}
          <div class="pl-rcard pl-glass" {{ block.shopify_attributes }}>
            {%- assign stars = block.settings.stars | default: 5 -%}
            <div class="pl-rcard__stars" aria-hidden="true">{% for star in (1..stars) %}★{% endfor %}</div>
            <span class="visually-hidden">{{ stars }} out of 5 stars</span>
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p>{{ block.settings.body }}</p>
            {% endif %}
            <div class="pl-rcard__who">
              <b>{{ block.settings.author }}</b>
              {% render 'purelane-icons', name: 'verified' %}
              {% if block.settings.product_name != blank %}
                <span>{{ block.settings.product_name }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('#shopify-section-{{ section.id }} .pl-rv').forEach(el => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "Purelane Reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "Aggregate Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "total_reviews",
      "label": "Total Reviews",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes Count",
      "default": "12 lakh+"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review Body"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_name": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_name": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_name": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_name": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_name": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
